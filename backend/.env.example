# 복사해서 backend/.env로 쓴다. 실제 .env는 커밋하지 않는다.
# 기본값 없음: 없거나 local/aws가 아니면 서버가 시작하지 않는다.
APP_MODE=local
# compose.yaml의 로컬 DB 주소
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app

# local일 때 필수. 64자 이상. PC마다 만든다:
#   python -c "import secrets; print(secrets.token_hex(32))"
LOCAL_URL_SECRET=
# 로컬 업로드 URL의 앞부분. 백엔드를 띄운 주소와 같아야 한다
LOCAL_BASE_URL=http://localhost:8000

# aws일 때 필수 (서버 .env는 배포 워크플로가 만든다)
AWS_REGION=
S3_BUCKET_PREFIX=
SQS_QUEUE_URL=
GPU_INSTANCE_ID=
