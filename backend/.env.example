# 복사해서 backend/.env로 쓴다. 실제 .env는 커밋하지 않는다.
# 기본값 없음: 없거나 local/aws가 아니면 서버가 시작하지 않는다.
APP_MODE=local
# compose.yaml의 로컬 DB 주소
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app

# local일 때 필수. 64자 이상. PC마다 만든다:
#   python -c "import secrets; print(secrets.token_hex(32))"
LOCAL_URL_SECRET=
# 로컬 업로드 URL의 앞부분. 백엔드를 띄운 주소와 같아야 한다
LOCAL_BASE_URL=http://localhost:8000

# aws일 때 필수 (서버 .env는 배포 워크플로가 만든다)
AWS_REGION=
S3_BUCKET_PREFIX=
SQS_QUEUE_URL=
GPU_INSTANCE_ID=

# 웹 푸시 (D-348). 비워 두면 푸시를 보내지 않고 나머지는 그대로 동작한다.
# 키는 PC마다 만든다. 배포 키를 로컬에 복사하지 않는다:
#   uv run python -m scripts.gen_vapid_keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# 푸시 서버에 알리는 연락처. https:// 주소(포트 없이)나 mailto:만 받는다.
# 로컬은 https://localhost, 배포는 CloudFront 주소
VAPID_SUBJECT=

# 카카오 인증 가입 (D-346). 비워 두면 가입 시작(35번)이 503을 주고, 로그인·스크립트 계정은 그대로 동작한다.
# 카카오 개발자 콘솔의 REST API 키와 client secret. 저장소·채팅에 붙이지 않는다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 콘솔에 등록한 주소와 같아야 한다. 로컬은 http://localhost:8000/api/auth/kakao/callback
KAKAO_REDIRECT_URI=
